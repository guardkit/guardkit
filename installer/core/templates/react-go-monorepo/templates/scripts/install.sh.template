#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/require-tools.sh
digest() { if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }
# Locked installs only. npm ci refuses a lockfile/manifest mismatch, go mod verify
# refuses tampered downloads, and the read-only go list fails on a missing go.sum
# line. go mod download can still quietly re-add a dropped go.sum line, so both
# lockfiles must be byte-identical afterwards.
go_sum_before="$(digest apps/api/go.sum)"
npm_lock_before="$(digest package-lock.json)"
npm ci --ignore-scripts --no-audit --no-fund
(
  cd apps/api
  go mod download
  go mod verify
  go list -deps -test ./... >/dev/null
)
[[ "$(digest apps/api/go.sum)" == "$go_sum_before" ]] || { echo 'go.sum changed during install; commit the complete file' >&2; exit 1; }
[[ "$(digest package-lock.json)" == "$npm_lock_before" ]] || { echo 'package-lock.json changed during install; commit the complete file' >&2; exit 1; }
