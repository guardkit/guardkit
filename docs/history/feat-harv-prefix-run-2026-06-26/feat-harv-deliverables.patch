+    @pytest.mark.asyncio
+    async def test_publish_lifecycle_ordering(
+        self,
+        sample_episodes: list[MemoryEpisodeV1],
+        mock_nats_client: AsyncMock,
+    ) -> None:
+        """Verifies connect → publish × N → disconnect ordering."""
+        result = await publish_episodes(sample_episodes, mock_nats_client)
+
+        # Verify the correct call ordering
+        mock_nats_client.connect.assert_called_once()
+        assert mock_nats_client.publish_episode.call_count == len(sample_episodes)
+        mock_nats_client.disconnect.assert_called_once()
+
+        # Verify disconnect is called with no arguments
+        mock_nats_client.disconnect.assert_called_with()
+
+        # Verify result
+        assert result.published == 2
+        assert result.skipped_oversized == 0
+        assert result.counts_per_type == {"task-outcome": 1, "design-decision": 1}
+
+    @pytest.mark.asyncio
+    async def test_each_episode_published_exactly_once(
