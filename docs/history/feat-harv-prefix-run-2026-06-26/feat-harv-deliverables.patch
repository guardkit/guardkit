+"""Unit tests for guardkit.memory.harvest_taxonomy module.
+
+Tests cover:
+- Episode ID derivation (byte-identical to fleet-memory)
+- Natural key generation
+- Episode type resolution with longest-prefix matching
+- NATS subject segment validation
+- Determinism guarantees
+- Exclusion of transient directories
+"""
+
+from __future__ import annotations
+
+import hashlib
+
+import pytest
+
+from guardkit.memory.harvest_taxonomy import (
+    HARVEST_MAP,
+    derive_episode_id,
+    episode_type_for,
+    natural_key_for,
+    validate_episode_types,
+)
+
+
+class TestDeriveEpisodeId:
+    """Tests for derive_episode_id function."""
+
+    def test_derive_episode_id_format(self) -> None:
+        """Episode ID should have format 'ep-{16-hex-chars}'."""
+        natural_key = "guardkit:docs/adr/001.md:adr"
+        episode_id = derive_episode_id(natural_key)
+
+        assert episode_id.startswith("ep-")
+        assert len(episode_id) == 19  # "ep-" (3) + 16 hex chars
+        # Verify it's valid hex
+        assert all(c in "0123456789abcdef" for c in episode_id[3:])
+
+    def test_derive_episode_id_deterministic(self) -> None:
+        """Same natural key should always produce the same episode ID."""
+        natural_key = "guardkit:docs/reviews/report.md:review_report"
+
+        id1 = derive_episode_id(natural_key)
+        id2 = derive_episode_id(natural_key)
+        id3 = derive_episode_id(natural_key)
+
+        assert id1 == id2 == id3
+
+    def test_derive_episode_id_different_keys_produce_different_ids(self) -> None:
+        """Different natural keys should produce different episode IDs."""
+        id1 = derive_episode_id("guardkit:docs/adr/001.md:adr")
+        id2 = derive_episode_id("guardkit:docs/adr/002.md:adr")
+        id3 = derive_episode_id("guardkit:docs/reviews/report.md:review_report")
+
+        assert id1 != id2
+        assert id1 != id3
+        assert id2 != id3
+
+    def test_derive_episode_id_matches_fleet_memory_algorithm(self) -> None:
+        """Episode ID derivation must be byte-identical to fleet-memory's algorithm.
+
+        This test verifies the algorithm matches:
+        fleet-memory/src/fleet_memory/reindex/publisher.py::_derive_episode_id
+
+        The algorithm is:
+        1. Encode natural_key as UTF-8 bytes
+        2. Compute SHA-256 hash
+        3. Take first 16 characters of hex digest
+        4. Prepend "ep-"
+        """
+        natural_key = "guardkit:docs/adr/001-decision.md:adr"
+
+        # Our implementation
+        our_id = derive_episode_id(natural_key)
+
+        # Fleet-memory's algorithm (inline reference implementation)
+        hash_bytes = hashlib.sha256(natural_key.encode("utf-8")).digest()
+        expected_id = f"ep-{hash_bytes.hex()[:16]}"
+
+        assert our_id == expected_id, (
+            f"Episode ID algorithm does not match fleet-memory. "
+            f"Expected: {expected_id}, Got: {our_id}"
+        )
+
+    def test_derive_episode_id_unicode_handling(self) -> None:
+        """Episode ID should handle Unicode characters in natural key."""
+        natural_key = "guardkit:docs/adr/001-décision.md:adr"
+        episode_id = derive_episode_id(natural_key)
