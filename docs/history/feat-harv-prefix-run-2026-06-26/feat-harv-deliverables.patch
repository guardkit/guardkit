+"""Harvest taxonomy configuration and deterministic episode ID derivation.
+
+This module provides pure-Python configuration and utilities for mapping documentation
+artifacts to episode types and deriving deterministic episode IDs. No I/O, no external
+dependencies - just config and algorithms.
+
+The taxonomy defines which directories contain which types of artifacts, and the
+episode_id algorithm ensures idempotent publishing (same artifact = same ID).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class HarvestEntry:
+    """Configuration for a single harvest category.
+
+    Attributes:
+        episode_type: NATS-safe identifier for this category (e.g., 'adr', 'review_report')
+        directories: List of directory paths to scan for this type
+        content_format: Format of the content (e.g., 'markdown', 'json')
+        exclude_patterns: Optional list of glob patterns to exclude
+    """
+    episode_type: str
+    directories: list[str]
+    content_format: str
+    exclude_patterns: list[str] | None = None
+
+
+# Transient directories that should never be harvested
+EXCLUDED_DIRS = {
+    "archive",
+    "checkpoints",
+    "state",
+    "history",
+}
+
+
+# Harvest taxonomy: curated allow-list of episode types
+HARVEST_MAP: dict[str, HarvestEntry] = {
+    "adr": HarvestEntry(
+        episode_type="adr",
+        directories=["docs/adr", "docs/adrs", "docs/decisions"],
+        content_format="markdown",
+    ),
+    "review_report": HarvestEntry(
+        episode_type="review_report",
+        directories=["docs/reviews", "docs/code-review"],
+        content_format="markdown",
+    ),
+    "feature_outcome": HarvestEntry(
+        episode_type="feature_outcome",
+        directories=["docs/completion-reports", "docs/retro"],
+        content_format="markdown",
+    ),
+    "document": HarvestEntry(
+        episode_type="document",
+        directories=["docs/design", "docs/guides", "docs/reference"],
+        content_format="markdown",
+    ),
+}
+
+
+def derive_episode_id(natural_key: str) -> str:
+    """Derive deterministic episode_id from natural key.
+
+    This implementation is byte-identical to fleet-memory's _derive_episode_id
+    to ensure both publishers agree on IDs for shared artifacts.
+
+    Uses SHA-256 hash of natural key to ensure the same payload published twice
+    yields the same episode_id for JetStream Msg-Id deduplication.
+
+    Args:
+        natural_key: Three-segment colon-separated key (typically project:path:type)
+
+    Returns:
+        Deterministic episode ID in format "ep-{16-char-hex}"
+
+    Examples:
+        >>> derive_episode_id("guardkit:docs/adr/001-decision.md:adr")
+        'ep-a1b2c3d4e5f67890'
+    """
+    hash_bytes = hashlib.sha256(natural_key.encode("utf-8")).digest()
+    return f"ep-{hash_bytes.hex()[:16]}"
+
+
+def natural_key_for(repo_relative_path: str, episode_type: str) -> str:
+    """Generate natural key for an artifact.
+
+    The natural key is a three-segment identifier used to derive the episode_id.
+    Format: "guardkit:{repo_relative_path}:{episode_type}"
+
+    Args:
+        repo_relative_path: Path relative to repository root
+        episode_type: Type of episode (from HARVEST_MAP keys)
+
+    Returns:
+        Three-segment natural key string
+
+    Examples:
+        >>> natural_key_for("docs/adr/001-decision.md", "adr")
+        'guardkit:docs/adr/001-decision.md:adr'
+    """
+    return f"guardkit:{repo_relative_path}:{episode_type}"
+
+
+def episode_type_for(repo_relative_path: str) -> str | None:
+    """Resolve episode type for a repository path.
+
+    Uses longest-prefix matching against HARVEST_MAP directories to determine
+    the episode type. Returns None for paths outside the allow-list.
+
+    Automatically excludes paths containing transient directory names
+    (archive, checkpoints, state, history).
+
+    Args:
+        repo_relative_path: Path relative to repository root (forward slashes)
+
+    Returns:
+        Episode type string if path matches a harvest category, None otherwise
+
+    Examples:
+        >>> episode_type_for("docs/adr/001-decision.md")
+        'adr'
+        >>> episode_type_for("docs/reviews/task-review.md")
+        'review_report'
+        >>> episode_type_for("docs/archive/old-adr.md")  # Excluded
+        None
+        >>> episode_type_for("src/main.py")  # Not in harvest map
+        None
+    """
+    # Normalize path separators and convert to Path for easier manipulation
+    path = Path(repo_relative_path)
+    path_parts = path.parts
+
+    # Check for excluded directories anywhere in the path
+    if any(part in EXCLUDED_DIRS for part in path_parts):
+        return None
+
+    # Find longest matching prefix
+    best_match: tuple[str, int] | None = None  # (episode_type, prefix_length)
+
+    for episode_type, entry in HARVEST_MAP.items():
+        for directory in entry.directories:
+            dir_path = Path(directory)
+            dir_parts = dir_path.parts
+
+            # Check if path starts with this directory
+            if len(path_parts) >= len(dir_parts):
+                if all(
+                    path_parts[i] == dir_parts[i]
+                    for i in range(len(dir_parts))
+                ):
+                    # This directory matches - check if it's the longest match so far
+                    prefix_len = len(dir_parts)
+                    if best_match is None or prefix_len > best_match[1]:
+                        best_match = (episode_type, prefix_len)
+
+    return best_match[0] if best_match else None
+
+
+def validate_episode_types() -> None:
+    """Validate that all episode types are NATS-safe subject segments.
+
+    NATS subject segments must match: ^[a-zA-Z0-9][a-zA-Z0-9\\-_]*$
+    (start with alphanumeric, followed by alphanumeric, hyphens, or underscores)
+
+    Raises:
+        ValueError: If any episode_type is not a valid NATS subject segment
+    """
+    nats_pattern = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9\-_]*$")
+
+    invalid_types = []
+    for episode_type in HARVEST_MAP.keys():
+        if not nats_pattern.match(episode_type):
+            invalid_types.append(episode_type)
+
+    if invalid_types:
+        raise ValueError(
+            f"Invalid NATS subject segments found: {invalid_types}. "
+            f"Episode types must match pattern: ^[a-zA-Z0-9][a-zA-Z0-9\\-_]*$"
+        )
+
+
+# Validate episode types on module import
+validate_episode_types()
