+"""NATS harvest publisher for memory episodes.
+
+Publishes a list of MemoryEpisodeV1 instances to the NATS broker using the
+provisioned 'guardkit' user. Handles oversized episodes (>900KB) gracefully
+and maintains idempotency via deterministic episode IDs.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from nats_core import MAX_EPISODE_BODY_BYTES, MemoryEpisodeV1, NATSClient, NATSConfig
+from pydantic import SecretStr
+
+if TYPE_CHECKING:
+    from collections.abc import Sequence
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class PublishResult:
+    """Summary of a publish operation.
+
+    Attributes:
+        published: Number of episodes successfully published.
+        skipped_oversized: Number of episodes skipped due to size >900KB.
+        counts_per_type: Count of published episodes by episode_type.
+    """
+
+    published: int = 0
+    skipped_oversized: int = 0
+    counts_per_type: dict[str, int] = field(default_factory=dict)
+
+
+def build_nats_client(env_file: Path | None = None) -> NATSClient:
+    """Build a NATSClient configured for the guardkit harvest publisher.
+
+    Reads GUARDKIT_NATS_PASSWORD from the environment or an optional .env file.
+    Raises an actionable error if the password is missing or blank.
+
+    Args:
+        env_file: Optional path to a .env file containing GUARDKIT_NATS_PASSWORD.
+
+    Returns:
+        Configured NATSClient ready to connect.
+
+    Raises:
+        ValueError: If GUARDKIT_NATS_PASSWORD is not set or is blank.
+    """
+    # Load from env_file if provided
+    if env_file is not None:
+        # Load variables from the env file
+        if env_file.exists():
+            with env_file.open() as f:
+                for line in f:
+                    line = line.strip()
+                    if line and not line.startswith("#") and "=" in line:
+                        key, value = line.split("=", 1)
+                        os.environ.setdefault(key, value)
+
+    # Read password from environment
+    password = os.environ.get("GUARDKIT_NATS_PASSWORD", "").strip()
+
+    if not password:
+        msg = (
+            "GUARDKIT_NATS_PASSWORD is not set or is blank. "
+            "Set this environment variable to the provisioned 'guardkit' user password. "
+            "You can set it directly in your shell or via an .env file "
+            "(pass --env-file path/to/.env to the harvest command)."
+        )
+        raise ValueError(msg)
+
+    # Build NATSConfig with the required parameters
+    config = NATSConfig(
+        url="nats://127.0.0.1:4222",
+        user="guardkit",
+        password=SecretStr(password),
+        name="guardkit-harvest",
+    )
+
+    # Build NATSClient with source_id
+    return NATSClient(config, source_id="guardkit-harvest")
+
+
+async def publish_episodes(
+    episodes: Sequence[MemoryEpisodeV1],
+    client: NATSClient,
+) -> PublishResult:
+    """Publish a sequence of memory episodes to NATS.
+
+    Connects to the NATS broker, publishes each episode via client.publish_episode,
+    and disconnects. Handles oversized episodes (>900KB) gracefully by skipping them
+    with an actionable error message. Never aborts the entire run for one oversized
+    episode.
+
+    The publish is idempotent: re-running publishes the same episode_ids, relying on
+    JetStream's Nats-Msg-Id deduplication (server-side).
+
+    Args:
+        episodes: Sequence of MemoryEpisodeV1 instances to publish.
+        client: NATSClient instance (must not be connected yet).
+
+    Returns:
+        PublishResult summarizing the operation.
+
+    Raises:
+        RuntimeError: If an unexpected error occurs during the publish lifecycle
+                     (after disconnect has been attempted).
+    """
+    result = PublishResult()
+
+    try:
+        # Connect to NATS
+        await client.connect()
+
+        # Publish each episode
+        for episode in episodes:
+            try:
+                await client.publish_episode(episode)
+                result.published += 1
+
+                # Track count per type
+                episode_type = episode.episode_type
+                result.counts_per_type[episode_type] = (
+                    result.counts_per_type.get(episode_type, 0) + 1
+                )
+
+            except ValueError as exc:
+                # Handle oversized episode (any ValueError from publish_episode
+                # is treated as an oversized episode per the AC)
+                result.skipped_oversized += 1
+                size_bytes = len(episode.body.encode())
+                logger.warning(
+                    "Skipped oversized episode %s (%d bytes, >%d byte limit). %s",
+                    episode.episode_id,
+                    size_bytes,
+                    MAX_EPISODE_BODY_BYTES,
+                    "chunk upstream",
+                )
+
+    finally:
+        # Always disconnect, even if errors occurred
+        await client.disconnect()
+
+    return result
