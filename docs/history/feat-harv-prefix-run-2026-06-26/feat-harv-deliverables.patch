+
+    def test_blank_password_raises_actionable_error(self) -> None:
+        """Blank GUARDKIT_NATS_PASSWORD raises with actionable message."""
+        with (
+            patch.dict(os.environ, {"GUARDKIT_NATS_PASSWORD": "   "}, clear=True),
+            pytest.raises(
+                ValueError,
+                match=r"GUARDKIT_NATS_PASSWORD.*blank",
+            ),
+        ):
+            build_nats_client()
+
+    def test_builds_config_with_correct_parameters(self) -> None:
