+        await publish_episodes(sample_episodes, mock_nats_client)
+
+        # Verify each episode was published
+        published_episodes = [
+            call[0][0] for call in mock_nats_client.publish_episode.call_args_list
+        ]
+        assert published_episodes == sample_episodes
