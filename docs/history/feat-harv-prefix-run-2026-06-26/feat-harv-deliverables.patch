+        mock_nats_client.publish_episode.side_effect = publish_side_effect
+
+        # Mix in oversized episode
+        episodes = [sample_episodes[0], oversized_episode, sample_episodes[1]]
+
+        result = await publish_episodes(episodes, mock_nats_client)
